  "rules": [
    {
      "id": "open_destination",
      "patterns": [
        "open <destination>",
        "bring up <destination>"
      ],
      "intent_type": "open_destination",
      "arguments": [
        [
          "destination",
          "$destination"
        ]
      ],
      "command": "site:{destination}",
      "label": "Open {destination}",
      "scope": "global"
    },
